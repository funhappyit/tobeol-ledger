{
  "name": "tobeol-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build --dotenv .env.local",
    "preview": "nuxt preview --dotenv .env.local",
    "postinstall": "nuxt prepare",
    "lint": "eslint app server src scripts",
    "collect": "tsx scripts/collect-items.ts",
    "collect:pocket": "tsx scripts/collect-pocket.ts",
    "collect:mogumogu": "tsx scripts/collect-mogumogu.ts",
    "collect:stock": "tsx scripts/collect-stock.ts",
    "load": "node --import tsx --env-file=.env.local scripts/load-items.ts",
    "load:stock": "node --import tsx --env-file=.env.local scripts/load-stock.ts",
    "check:schema": "node --import tsx --env-file=.env.local scripts/check-schema.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^20",
    "eslint": "^9",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vue-tsc": "^3.3.14"
  }
}
