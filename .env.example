# Supabase — 대시보드 Project Settings > API 에서 복사
# anon(publishable) key 는 브라우저에 노출되는 공개 키이므로 커밋해도 무해하지만,
# 이 파일은 예시용이므로 실제 값은 .env.local 에만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — RLS 를 우회하는 마스터 키. 절대 커밋·노출 금지.
# 굿즈 수집 스크립트(scripts/)에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# 굿즈 수집 대상 공식몰
CHIIKAWA_MARKET_ORIGIN=https://chiikawamarket.jp
# 수집 요청 간격(ms) — 상대 서버 부하를 고려해 200 이상 유지
COLLECT_REQUEST_INTERVAL_MS=300

# 환율 API (키 불필요, ECB 기준 / 과거 일자 조회 지원)
FX_API_BASE=https://api.frankfurter.app

# cron 수동 트리거 보호용 토큰 (임의의 긴 문자열)
CRON_SECRET=
